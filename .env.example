# Скопируй в .env.local и заполни. Реальные значения никогда не коммить.
# Значения NEXT_PUBLIC_* вшиваются в браузерный JS: туда только публичные, несекретные значения.

# Supabase (этап 2). Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…, раньше «anon»): публичный, доступ ограничивают GRANT и RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, раньше «service_role»). Только сервер, обходит RLS.
# Используется в вебхуках Stripe, фоновых задачах (lib/supabase/admin.ts), скриптах и тестах.
SUPABASE_SECRET_KEY=

# Вход через Google: true только после настройки OAuth (docs/setup-google-auth.md).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Пароль демо-аккаунтов (необязательно, по умолчанию SlotwiseDemo2026).
DEMO_PASSWORD=

# Stripe (этап 3), тестовый режим. Настройка: docs/setup-stripe.md.
# Secret key (sk_test_…): Developers → API keys.
STRIPE_SECRET_KEY=
# Подпись вебхуков (whsec_…): печатает `npm run stripe:listen` при запуске.
STRIPE_WEBHOOK_SECRET=
# Цены Pro не копируются сюда: их находят по lookup key (npm run stripe:setup создаёт их).
# Publishable key не нужен: оплата идёт на странице Stripe Checkout, а не в нашем браузерном коде.

# AI (этап 4): Gemini через Vercel AI SDK. Ключ: aistudio.google.com → Get API key (есть бесплатный тариф).
# Без ключа чат, черновик профиля и сводка показывают «недоступно», остальное работает.
GOOGLE_GENERATIVE_AI_API_KEY=
# Необязательно: другая модель Gemini (по умолчанию gemini-3.5-flash-lite).
AI_CHAT_MODEL=
# Подпись подтверждений инструментов (отмена брони из чата): openssl rand -base64 32.
TOOL_APPROVAL_SECRET=

# Письма (этап 3). Без ключа письма не отправляются, а пишутся в консоль сервера.
RESEND_API_KEY=
# Отправитель. Без своего домена в Resend — только onboarding@resend.dev.
EMAIL_FROM=Slotwise <onboarding@resend.dev>
# Для разработки: все письма уходят на этот адрес (Resend без домена доставляет только владельцу
# аккаунта). Настоящий получатель пишется в теме. В продакшене оставить пустым.
EMAIL_DEV_TO=

# Фоновые задачи (этап 3). Локально: INNGEST_DEV=1 и `npm run jobs:dev` (ключи не нужны).
INNGEST_DEV=1
# Только для облачного Inngest (деплой):
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Мониторинг (этап 5). Без DSN Sentry выключен. DSN публичный по устройству: он только разрешает
# отправлять события в проект.
NEXT_PUBLIC_SENTRY_DSN=
# development / staging / production — подпись событий Sentry.
NEXT_PUBLIC_APP_ENV=development
# Только CI/деплой: загрузка source maps в Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
