// Generates supabase/seed.sql from lib/catalog/seed-data.ts, so local data, tests and
// the database seed can never drift apart. Run: npm run db:seed
//
// Every insert is an upsert on id: applying the seed again (`npm run db:seed:remote`) brings the demo
// rows back to this file, including profiles an admin suspended or edited by hand. Columns the seed
// does not set (a provider's user_id) are left alone. Rows are never deleted: bookings reference
// services with "on delete restrict", and they keep their own copy of title, price and names.
import { writeFileSync } from "node:fs";
import { join } from "node:path";

import {
  availabilityExceptions,
  availabilityRules,
  providers,
  reviews,
  services,
} from "../lib/catalog/seed-data.ts";

const str = (value: string) => `'${value.replace(/'/g, "''")}'`;
const arr = (values: string[]) => `array[${values.map(str).join(", ")}]::text[]`;
const bool = (value: boolean) => (value ? "true" : "false");
const nullable = (value: string | null) => (value === null ? "null" : str(value));
const row = (values: (string | number)[]) => `  (${values.join(", ")})`;

const insert = (table: string, columns: string[], rows: string[]) =>
  `insert into public.${table}
  (${columns.join(", ")})
values
${rows.join(",\n")}
on conflict (id) do update set
  ${columns
    .filter((c) => c !== "id")
    .map((c) => `${c} = excluded.${c}`)
    .join(",\n  ")};`;

const sql = `-- Generated by scripts/generate-seed.mts from lib/catalog/seed-data.ts. Do not edit by hand.
-- Demo catalog: ${providers.length} providers, ${services.length} services, ${reviews.length} reviews,
-- ${availabilityRules.length} schedule rules, ${availabilityExceptions.length} schedule exceptions.

begin;

-- A changed seed can give a slug to another id (olivia-yoga moved from one row to another): free
-- the slugs of the demo rows first, so the upsert below never hits the unique constraint.
update public.providers
set slug = 'seed-' || replace(id::text, '-', '')
where id in (${providers.map((p) => str(p.id)).join(", ")});

${insert(
  "providers",
  [
    "id",
    "slug",
    "display_name",
    "headline",
    "bio",
    "category",
    "city",
    "timezone",
    "offers_online",
    "offers_in_person",
    "years_experience",
    "languages",
    "status",
    "photo_url",
    "updated_at",
  ],
  providers.map((p) =>
    row([
      str(p.id),
      str(p.slug),
      str(p.displayName),
      str(p.headline),
      str(p.bio),
      str(p.category),
      str(p.city),
      str(p.timezone),
      bool(p.offersOnline),
      bool(p.offersInPerson),
      p.yearsExperience,
      arr(p.languages),
      str(p.status),
      nullable(p.photoUrl),
      str(p.updatedAt),
    ]),
  ),
)}

${insert(
  "services",
  [
    "id",
    "provider_id",
    "title",
    "description",
    "duration_min",
    "price_cents",
    "currency",
    "active",
  ],
  services.map((s) =>
    row([
      str(s.id),
      str(s.providerId),
      str(s.title),
      str(s.description),
      s.durationMin,
      s.priceCents,
      str(s.currency),
      bool(s.active),
    ]),
  ),
)}

${insert(
  "reviews",
  ["id", "provider_id", "author_name", "rating", "body", "hidden", "hidden_reason", "created_at"],
  reviews.map((r) =>
    row([
      str(r.id),
      str(r.providerId),
      str(r.authorName),
      r.rating,
      str(r.body),
      bool(r.hidden),
      // The one hidden demo review shows why an admin would hide one.
      nullable(r.hidden ? "Shares a personal phone number" : null),
      str(r.createdAt),
    ]),
  ),
)}

${insert(
  "availability_rules",
  ["id", "provider_id", "weekday", "start_time", "end_time"],
  availabilityRules.map((r) =>
    row([str(r.id), str(r.providerId), r.weekday, str(r.startTime), str(r.endTime)]),
  ),
)}

${insert(
  "availability_exceptions",
  ["id", "provider_id", "date", "start_time", "end_time", "reason"],
  availabilityExceptions.map((e) =>
    row([
      str(e.id),
      str(e.providerId),
      str(e.date),
      nullable(e.startTime),
      nullable(e.endTime),
      str(e.reason),
    ]),
  ),
)}

commit;
`;

const out = join(import.meta.dirname, "..", "supabase", "seed.sql");
writeFileSync(out, sql);
console.log(
  `Wrote ${out}: ${providers.length} providers, ${services.length} services, ${reviews.length} reviews, ` +
    `${availabilityRules.length} rules, ${availabilityExceptions.length} exceptions`,
);
