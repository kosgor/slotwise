{
  "name": "slotwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "db:seed": "node scripts/generate-seed.mts",
    "db:seed:remote": "supabase db query --linked -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "db:demo-users": "node scripts/seed-demo-users.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "stripe:setup": "node scripts/stripe-setup.mts",
    "stripe:listen": "node scripts/stripe-listen.mts",
    "jobs:dev": "npx --yes inngest-cli@1.45.1 dev -u http://localhost:3000/api/inngest",
    "email:dev": "npx --yes react-email@6.11.0 dev --dir emails/preview --port 3200",
    "evals": "node scripts/run-evals.mts",
    "security:bundle": "node scripts/check-bundle-secrets.mts",
    "db:backup": "node scripts/db-backup.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/react": "^4.0.138",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "ai": "^7.0.135",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "inngest": "^4.21.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
